{
  "manifest_version": 3,
  "name": "Gemini Live Chat",
  "version": "1.4",
  "description": "Captura la conversaci\u00f3n en vivo de Gemini en una ventana emergente y la env\u00eda por WebSocket.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "Abrir Gemini Live Chat"
  }
}